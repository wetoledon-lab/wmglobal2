    tag: '01 / Upstream',
    icon: 'oil_barrel',
    title: 'Servicios Petroleros Especializados',
    description: 'Intervención, perforación y soporte operacional en fondo y superficie para pozos petroleros.',
    items: [
      'Perforación de pozos (Rig Drilling)',
      'Intervención y rehabilitación (Workover)',
      'Well Testing & Pruebas de producción',
      'Coiled Tubing y servicios de pozo',
      'Servicios y facilidades de producción temprana',
      'Mantenimiento industrial mecánico, eléctrico e instrumentación',
    ],
    ctaText: 'Solicitar evaluación',
  },
  {
    index: 1,
    tag: '02 / Transporte',
    icon: 'local_shipping',
    title: 'Logística y Movilización Especializada',
    description: 'Soluciones logísticas de gran envergadura para el traslado eficiente de personal, taladros y cargas críticas.',
    items: [
      'Transporte de personal especializado y operativo',
      'Movilización y mudanza de equipos pesados (taladros, maquinaria)',
