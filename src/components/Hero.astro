---
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden -mt-20 pt-20" id="inicio">
  <div class="absolute inset-0 z-0">
    <div
      class="bg-cover bg-center w-full h-full absolute inset-0"
      style="background-image: url('/images/hero-refinery.jpg');"
      role="img"
      aria-label="Refinería petrolera de alta tecnología"
    ></div>
    <div class="absolute inset-0 bg-primary/80 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 w-full max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop py-24 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-glass/20 border border-white/20 backdrop-blur-md mb-8 animate-fade-in-up">
      <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
      <span class="font-label-caps text-xs md:text-sm uppercase tracking-widest text-on-primary">
        Excelencia Operacional Global
      </span>
    </div>

    <h1 class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-primary mb-6 max-w-4xl mx-auto animate-fade-in-up delay-100">
      Soluciones Integrales para la Industria Petrolera, Energética y de Construcción
    </h1>

    <p class="font-body-lg text-body-md md:text-body-lg text-inverse-primary mb-12 max-w-2xl mx-auto animate-fade-in-up delay-200">
      Optimizamos operaciones con ingeniería de precisión, tecnología avanzada y un compromiso inquebrantable con la calidad y la seguridad.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up delay-300">
      <a
        class="px-8 py-4 bg-secondary text-on-secondary font-button text-button rounded-lg hover:bg-secondary/90 transition-colors shadow-lg flex items-center justify-center gap-2"
        href="#contacto"
      >
        <span>Solicitar Propuesta</span>
        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </a>

      <a
        class="px-8 py-4 bg-surface-glass backdrop-blur-sm text-primary font-button text-button rounded-lg hover:bg-white transition-colors border border-white/40 shadow-sm"
        href="#servicios"
      >
        Explorar Servicios
      </a>
    </div>
  </div>
</section>
