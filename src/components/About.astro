---
const values = [
  {
    icon: 'handshake',
    title: 'Compromiso',
    description: 'Dedicación total al éxito y continuidad productiva de cada proyecto y cliente.',
  },
  {
    icon: 'gavel',
    title: 'Ética Profesional',
    description: 'Transparencia, rigurosidad e integridad en todas nuestras operaciones comerciales.',
  },
  {
    icon: 'military_tech',
    title: 'Calidad',
    description: 'Búsqueda constante de la excelencia técnica, protocolos seguros y mejora continua.',
  },
];
---

<section class="py-section-gap bg-background" id="nosotros">
  <div class="max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
      <div>
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
          <span class="font-label-caps text-secondary text-xs uppercase tracking-widest">Sobre W&M Global</span>
        </div>

        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-6">
          Innovación y Respaldo Técnico
        </h2>

        <p class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed">
          En W&M GLOBAL C.A., somos una organización orientada al éxito, dedicada a ofrecer soluciones excepcionales en asesoramiento, logística y suministro integral de equipos, repuestos y consumibles para sectores clave de la industria petrolera, petroquímica e industrias en general.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
          <div class="bg-surface-container-lowest p-6 rounded-xl border border-border-technical shadow-sm hover:border-secondary/40 transition-colors">
            <div class="w-12 h-12 rounded-lg bg-secondary-container/30 text-secondary flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-3xl">track_changes</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface text-xl mb-2">Misión</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
              Proveer soporte técnico y logístico de excelencia, garantizando la operatividad continua y segura de nuestros clientes.
            </p>
          </div>

          <div class="bg-surface-container-lowest p-6 rounded-xl border border-border-technical shadow-sm hover:border-secondary/40 transition-colors">
            <div class="w-12 h-12 rounded-lg bg-secondary-container/30 text-secondary flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-3xl">visibility</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface text-xl mb-2">Visión</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
              Ser líderes globales en soluciones industriales, reconocidos por nuestra calidad, innovación y compromiso inquebrantable.
            </p>
          </div>
        </div>
      </div>

      <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-square lg:aspect-auto h-full min-h-[420px] border border-border-technical">
        <div
          class="absolute inset-0 w-full h-full bg-cover bg-center"
          style="background-image: url('/images/engineers.jpg');"
          role="img"
          aria-label="Ingenieros revisando planos técnicos en planta"
        ></div>
        <div class="absolute inset-0 bg-gradient-to-t from-primary/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-surface/90 backdrop-blur-md border border-white/20">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary text-2xl">verified</span>
            <span class="font-button text-sm text-primary">
              Operaciones certificadas bajo estándares internacionales
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Valores -->
    <div class="mb-4">
      <h3 class="font-headline-md text-headline-md text-center text-on-surface mb-12">
        Nuestros Valores Fundamentales
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((val) => (
          <div class="bg-surface-container p-8 rounded-xl text-center hover:-translate-y-2 hover:shadow-lg transition-all duration-300 border border-transparent hover:border-secondary/30">
            <div class="w-16 h-16 rounded-full bg-secondary-fixed/50 text-secondary mx-auto flex items-center justify-center mb-6">
              <span class="material-symbols-outlined text-3xl">{val.icon}</span>
            </div>
            <h4 class="font-headline-md text-headline-md text-on-surface text-lg mb-2">{val.title}</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{val.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
