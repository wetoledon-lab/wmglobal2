---
const navLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Sobre Nosotros', href: '#nosotros' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Contacto', href: '#contacto' },
];
---

<footer class="w-full bg-primary text-on-primary pt-section-padding pb-gutter border-t border-white/10">
  <div class="max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter mb-16">
      <div class="md:col-span-5">
        <div class="bg-white/95 p-3 rounded-lg inline-block shadow-sm hover:scale-105 transition-transform duration-300 mb-6">
          <img
            alt="W&M GLOBAL C.A. Logo"
            class="h-14 md:h-16 w-auto object-contain"
            src="/images/logo.png"
          />
        </div>
        <p class="text-body-md font-body-md text-on-primary/80 max-w-sm">
          Líderes en soporte técnico y soluciones integrales para el sector energético, petrolero y de construcción a nivel global.
        </p>
      </div>

      <div class="md:col-span-3">
        <h4 class="font-headline-md text-headline-md mb-6 text-white font-bold">Navegación</h4>
        <ul class="space-y-3">
          {navLinks.map((link) => (
            <li class="font-body-sm text-body-sm">
              <a class="hover:text-secondary-container transition-colors" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-4">
        <h4 class="font-headline-md text-headline-md mb-6 text-white font-bold">Contacto</h4>
        <div class="flex flex-col gap-4">
          <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-secondary-container mt-0.5">location_on</span>
            <span class="text-body-sm font-body-sm text-inverse-primary leading-relaxed font-semibold">
              AV INTERCOMUNAL LOCAL S/N ZONA INDUSTRIAL EL TIGRE<br />
              ANZOATEGUI ZONA POSTAL 6050
            </span>
          </div>

          <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-secondary-container mt-0.5">mail</span>
            <a
              href="mailto:admin@wmglobal.org"
              class="text-body-sm font-body-sm text-inverse-primary hover:text-secondary-container transition-colors"
            >
              admin@wmglobal.org
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="pt-gutter border-t border-on-primary/10 flex flex-col md:flex-row justify-between items-center gap-4 text-body-sm font-label-caps uppercase tracking-widest opacity-70">
      <span>© 2024 W&M GLOBAL C.A. Todos los derechos reservados.</span>
      <span>Precision &amp; Engineering Excellence</span>
    </div>
  </div>
</footer>
