---
const serviceOptions = [
  '1. Servicios Petroleros Especializados',
  '2. Logística y Movilización Especializada',
  '3. Suministro de Equipos de Seguridad y Protección (EPP)',
  '4. Servicios de Catering, Comida Empacada y Soporte de Campamento',
  '5. Construcción, Mantenimiento y Adecuación de Infraestructura',
  '6. Suministro de Materiales, Equipos y Piezas para la Industria',
  '7. Servicios Especializados de Climatización',
  '8. Mantenimiento Preventivo y Correctivo de Flota Liviana y Pesada',
  'Otro requerimiento a medida',
];
---

<section class="py-section-gap bg-background" id="contacto">
  <div class="max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Contact Form -->
      <div class="bg-surface-container-lowest p-8 rounded-xl shadow-lg border border-border-technical">
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">Contáctenos</h2>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-8">
          Nuestro equipo de ingenieros y especialistas está listo para evaluar sus requerimientos.
        </p>

        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Gracias por su mensaje. Nos comunicaremos a la brevedad.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block font-body-sm text-on-surface-variant mb-1 font-medium">
                Nombre Completo
              </label>
              <input
                class="w-full px-4 py-3 bg-surface border border-outline-variant rounded focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors"
                placeholder="Ej. Carlos Mendoza"
                required
                type="text"
              />
            </div>
            <div>
              <label class="block font-body-sm text-on-surface-variant mb-1 font-medium">
                Empresa
              </label>
              <input
                class="w-full px-4 py-3 bg-surface border border-outline-variant rounded focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors"
                placeholder="Razón Social"
                required
                type="text"
              />
            </div>
          </div>

          <div>
            <label class="block font-body-sm text-on-surface-variant mb-1 font-medium">
              Correo Electrónico Corporativo
            </label>
            <input
              class="w-full px-4 py-3 bg-surface border border-outline-variant rounded focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors"
              placeholder="correo@empresa.com"
              required
              type="email"
            />
          </div>

          <div>
            <label class="block font-body-sm text-on-surface-variant mb-1 font-medium">
              Servicio de interés
            </label>
            <select class="w-full px-4 py-3 bg-surface border border-outline-variant rounded focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors text-on-surface">
              {serviceOptions.map((opt) => (
                <option>{opt}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block font-body-sm text-on-surface-variant mb-1 font-medium">
              Mensaje / Requerimientos Técnicos
            </label>
            <textarea
              class="w-full px-4 py-3 bg-surface border border-outline-variant rounded focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors"
              placeholder="Detalle sus especificaciones, volúmenes o cronograma operacional..."
              required
              rows="4"
            ></textarea>
          </div>

          <button
            class="w-full px-6 py-4 bg-primary text-on-primary font-button rounded-lg hover:bg-primary/90 transition-all shadow-md flex items-center justify-center gap-2 group cursor-pointer"
            type="submit"
          >
            <span>Enviar Solicitud Técnica</span>
            <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">send</span>
          </button>
        </form>
      </div>

      <!-- Contact Info & Map -->
      <div class="flex flex-col justify-between">
        <div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-6">Oficina Principal</h3>
          <div class="space-y-6 mb-12">
            <div class="flex items-start gap-4 p-5 bg-surface-container rounded-xl border border-border-technical/80">
              <span class="material-symbols-outlined text-secondary text-2xl shrink-0 mt-0.5">location_on</span>
              <div>
                <h4 class="font-button text-on-surface font-semibold">Sede Operativa</h4>
                <p class="font-body-sm text-on-surface-variant mt-1 leading-relaxed font-semibold">
                  AV INTERCOMUNAL LOCAL S/N ZONA INDUSTRIAL EL TIGRE<br />
                  ANZOATEGUI ZONA POSTAL 6050
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-surface-container rounded-xl border border-border-technical/80">
              <span class="material-symbols-outlined text-secondary text-2xl shrink-0 mt-0.5">mail</span>
              <div>
                <h4 class="font-button text-on-surface font-semibold">Atención Comercial y Procura</h4>
                <p class="font-body-sm text-on-surface-variant mt-1">
                  <a
                    href="mailto:admin@wmglobal.org"
                    class="font-bold text-secondary hover:underline transition-colors"
                  >
                    admin@wmglobal.org
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="w-full h-64 rounded-xl overflow-hidden shadow-md border border-border-technical">
          <div
            class="w-full h-full bg-cover bg-center rounded-xl"
            style="background-image: url('/images/location-map.jpg');"
            role="img"
            aria-label="Mapa de ubicación en El Tigre, Anzoátegui, Venezuela"
          ></div>
        </div>
      </div>
    </div>
  </div>
</section>
